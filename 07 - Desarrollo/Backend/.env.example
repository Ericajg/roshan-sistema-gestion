# Copiar este archivo como ".env" en la PC donde corra el backend,
# y completar los valores reales. Nunca subir el ".env" real a git.

# Clave secreta para firmar los tokens de sesion (JWT).
# Generar una nueva y unica para cada instalacion con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Nombre de la PC (o instancia) donde corre SQL Server.
# Si instalaste "SQL Server Express" con la opcion basica, el nombre
# suele ser NOMBRE-DE-LA-PC\SQLEXPRESS
DB_SERVER=

# Nombre de la base de datos (no cambiar salvo que se haya renombrado).
DB_NAME=ROSHAN
